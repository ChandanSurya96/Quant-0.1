# =============================================================================
# Quant-Algorithm environment template
# AUTO-GENERATED from source of truth. Do not hand-edit the variable list.
# Regenerate with: /ecc:update-docs
#
# Copy to .env (gitignored) and fill in. Every variable below is OPTIONAL and
# falls back to the default shown, EXCEPT POLYGON_API_KEY, which fails closed
# when the Polygon provider is used.
# See docs/ENV.md for full semantics and safety-lock interactions.
# =============================================================================

# --- Market data: Polygon.io -------------------------------------------------
# quant/data/providers/polygon/models.py
# Required when PolygonProvider is used; ingestion raises
# PolygonAuthenticationError rather than returning empty/fabricated data.
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io
# Sleep (seconds) between requests. Raise this on rate-limited free tiers.
POLYGON_PACE_SECONDS=0.0

# --- Broker: Interactive Brokers ---------------------------------------------
# quant/broker/ibkr/models.py
IBKR_HOST=127.0.0.1
# 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=

# --- Persistence -------------------------------------------------------------
# quant/persistence/database.py
# SQLite path for run/order/fill/reconciliation state. ":memory:" keeps
# nothing across processes and is the default for tests and research runs.
QUANT_STATE_DB=:memory:

# --- Execution safety boundary -----------------------------------------------
# quant/runner/live_config.py, quant/runner/autonomous_config.py
# These interlock. Read docs/RUNBOOK.md before changing any of them.

# PAPER | LIVE. Anything else is rejected at config validation.
BROKER_ENV=PAPER

# Must be true for BROKER_ENV=LIVE to be accepted at all.
LIVE_EXECUTION_ENABLED=false

# Hard USD ceiling on controlled live execution. Must be > 0 in LIVE.
LIVE_CAPITAL_LIMIT=25000.0

# Kill switch. true blocks live and autonomous execution unconditionally.
EMERGENCY_STOP=false

# MANUAL_APPROVAL | AUTONOMOUS. Autonomous execution requires AUTONOMOUS.
APPROVAL_MODE=MANUAL_APPROVAL

# Must be true AND APPROVAL_MODE=AUTONOMOUS to run unattended cycles.
AUTONOMOUS_EXECUTION_ENABLED=false

# Optional USD ceiling for autonomous execution. Unset means "not configured",
# which the autonomous safety locks treat as a blocking condition in LIVE.
# MAX_LIVE_CAPITAL=

# --- Notifications (scripts/send-brief.js) -----------------------------------
# Telegram is tried first; Gmail is the fallback; with neither set the brief
# is printed to stdout.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
